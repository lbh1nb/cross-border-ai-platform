# ========== 飞书应用凭证 ==========
# 从飞书开放平台 > 企业自建应用 > 凭证与基础信息 获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 飞书多维表格 ==========
# 从多维表格 URL 中获取：https://xxx.feishu.cn/base/{APP_TOKEN}?table={TABLE_ID}
FEISHU_BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxx
# 飞书企业租户域名（从多维表格 URL 中提取，如 ocndodd7lmyr.feishu.cn 中的 ocndodd7lmyr）
# 用于生成在飞书桌面端可直接打开的链接（避免跳转浏览器重新登录）
FEISHU_TENANT_DOMAIN=ocndodd7lmyr
FEISHU_TABLE_ID_SELECTION=tblxxxxxxxxxxxxxx
FEISHU_TABLE_ID_LISTING=tblxxxxxxxxxxxxxx
FEISHU_TABLE_ID_DAILY_REPORT=tblxxxxxxxxxxxxxx
FEISHU_TABLE_ID_INVENTORY=tblxxxxxxxxxxxxxx
FEISHU_TABLE_ID_COLLECTION_CONFIG=tblxxxxxxxxxxxxxx

# ========== 飞书机器人 ==========
# 从群聊 > 设置 > 群机器人 > 添加机器人 > 自定义机器人 获取
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx
# 飞书群聊 ID（应用机器人发送审批卡片等需回调的消息时使用）
# 从群设置 → 群信息中获取，格式如 oc_xxxxxxxxxxxxxxxx
# 仅配 Webhook 机器人告警可不填
FEISHU_CHAT_ID=

# ========== 飞书审批流（08-06 审批流自动化）==========
# 审批定义 Code（UUID 格式，从飞书审批后台 URL 获取）
# 操作：飞书工作台 → 审批应用 → 创建审批 → 发布后从 URL 复制 definitionCode
FEISHU_APPROVAL_CODE=5458BD3D-F35F-4A34-A518-7CF8DED3EE6D
# 默认审批人 open_id（ou_ 开头，用于创建审批实例时指定审批人）
# 可通过 scripts/grant_table_permission.py 查询手机号对应的 open_id
FEISHU_APPROVAL_APPROVER_OPEN_ID=ou_xxxxxxxxxxxxxxxx
# 审批节点 ID（审批流程中"发起人自选审批人"节点的 node_id）
# 可通过 scripts/query_approval_definition.py 查询审批定义获取
FEISHU_APPROVAL_NODE_ID=10dc46fe719b8560e98461437cb663dc

# ========== AI 模型 API ==========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ========== 业务配置 ==========
# 库存预警阈值（天数）
INVENTORY_ALERT_DAYS=14
# 选品金额阈值（美金，超过触发审批）
PURCHASE_APPROVAL_THRESHOLD=5000
# 数据保留天数（超过此天数的数据将被自动清理，每3天凌晨2点执行）
DATA_RETENTION_DAYS=3

# ========== 日志级别 ==========
LOG_LEVEL=INFO
